{
  "imports": {
    "fast-png": "npm:fast-png@8.0.0"
  },
  "tasks": {
    "render": "deno run --allow-read --allow-write --allow-env --allow-run render/render.ts",
    "check": "deno check render/render.ts render/selftest.ts render/bench.ts",
    "selftest": "deno run --allow-read render/selftest.ts",
    "bench": "deno run --allow-read render/bench.ts"
  },
  "exclude": [
    "web/",
    "node_modules/",
    ".venv/"
  ]
}
