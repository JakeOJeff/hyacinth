# Copy to .env (same folder) and fill in. .env is gitignored; never commit it.
# Read by the web dev server (cd web && npm run dev) and the Python pipeline
# (python -m hyacinth ...). Real environment variables take precedence.

# --- AI: the "Ask Hyacinth" assistant and the daily caption (OpenAI) ---
OPENAI_API_KEY=sk-...
# Exact model ID from your OpenAI account (check it on the models page).
OPENAI_MODEL=gpt-6-luna

# --- Telegram delivery (python -m hyacinth post / daily) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@hyacinth_forecast

# --- Optional: barrage state when known (open | closed); otherwise seasonal default ---
HYACINTH_BARRAGE=

# --- Deploy only (GitHub Actions secrets in CI; locally for wrangler) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
